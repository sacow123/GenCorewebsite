{
  "name": "gencore-manual",
  "version": "1.0.0",
  "scripts": {
    "build": "echo \"No build required for static site\"",
    "vercel-build": "echo \"No build required for static site\"",
    "serve": "node tools/local-server.js",
    "check:i18n": "node tools/check-i18n.js",
    "check:i18n:ko-en": "node tools/check-i18n.js --lang ko,en",
    "check:i18n:strict": "node tools/check-i18n.js --strict-raw",
    "sync:i18n:visible": "node tools/sync-visible-i18n.js",
    "check:i18n:visible": "node tools/check-i18n.js --lang en,ja --strict-raw --strict-visible"
  },
  "dependencies": {
    "isomorphic-git": "^1.38.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0"
  }
}
