{
  "name": "gencore-manual",
  "version": "1.0.0",
  "scripts": {
    "build": "node tools/build-feature-search.cjs",
    "vercel-build": "node tools/build-feature-search.cjs",
    "build:search": "node tools/build-feature-search.cjs",
    "serve": "node tools/local-server.js",
    "check:i18n": "node tools/check-i18n.js",
    "check:i18n:ko-en": "node tools/check-i18n.js --lang ko,en",
    "check:i18n:strict": "node tools/check-i18n.js --strict-raw",
    "sync:i18n:visible": "node tools/sync-visible-i18n.js",
    "check:i18n:visible": "node tools/check-i18n.js --lang en,ja --strict-raw --strict-visible",
    "check:i18n:templates": "node tools/check-template-i18n.js",
    "check:i18n:all": "npm run check:i18n:visible && npm run check:i18n:templates",
    "test": "npm run check:i18n:all",
    "build:db:original": "node tools/extract-mai-selected-original.cjs && node tools/build-mai-original.js",
    "check:db:original": "node tools/check-mai-original.js && node tools/audit-mai-original-coverage.cjs"
  },
  "dependencies": {
    "isomorphic-git": "^1.38.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0"
  }
}
